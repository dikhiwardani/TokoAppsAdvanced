<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane stylesheets="@styles/app.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="kelas.controller.DetailController">
    <top>
        <HBox spacing="16" styleClass="header">
            <Label styleClass="title" text="Detail Produk" />
            <Button onAction="#bukaDaftar" text="Lihat Daftar" />
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true">
            <content>
                <VBox spacing="16" styleClass="page">
                    <VBox spacing="10" styleClass="card">
                        <Label styleClass="muted" text="Kode" />
                        <Label fx:id="kodeLabel" styleClass="subtitle" />
                        <Label styleClass="muted" text="Nama Produk" />
                        <Label fx:id="namaLabel" wrapText="true" />
                        <Label styleClass="muted" text="Jenis produk" />
                        <Label fx:id="jenisLabel" />
                        <Label styleClass="muted" text="Harga" />
                        <Label fx:id="hargaLabel" styleClass="title" />
                        <ImageView fx:id="gambarView" fitHeight="220" fitWidth="320" preserveRatio="true" />
                        <Label fx:id="pesanLabel" wrapText="true" />
                        <Button onAction="#tambahLagi" styleClass="button-primary" text="Tambah Produk Baru" />
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
